come","text":"the record should be valid"}],"examples":[]}},{"scenario":{"id":"2926c319-4268-4051-9a1e-474190c9476e","tags":[],"location":{"line":44,"column":3},"keyword":"Scenario","name":"The published spec Beneficiary example does not follow the IBR data standard","description":"","steps":[{"id":"0b8c2d56-b492-4667-b822-67fccc2dc191","location":{"line":45,"column":5},"keyword":"Given ","keywordType":"Context","text":"the \"spec example\" Beneficiary record"},{"id":"085d0d88-5ca2-4869-8427-d9e9d427903f","location":{"line":46,"column":5},"keyword":"Then ","keywordType":"Outcome","text":"the record should be rejected because of:","dataTable":{"location":{"line":47,"column":7},"rows":[{"id":"15980e15-656c-4a74-b36b-45ae4851a910","location":{"line":47,"column":7},"cells":[{"location":{"line":47,"column":9},"value":"/member/member_identifier must be array"}]},{"id":"21af320a-abb7-475b-8b03-bd0a96737583","location":{"line":48,"column":7},"cells":[{"location":{"line":48,"column":9},"value":"/member/related_person must be array"}]},{"id":"6867d0fd-0f91-4c32-8cfe-cc077d85e077","location":{"line":49,"column":7},"cells":[{"location":{"line":49,"column":9},"value":"/member/is_disabled must be equal to one of the allowed values"}]},{"id":"a2770ed3-978d-449e-9a62-4c90e50de2e8","location":{"line":50,"column":7},"cells":[{"location":{"line":50,"column":9},"value":"/member/disability_info must be array"}]},{"id":"af1b4319-ddf8-4161-a37d-053390210ddf","location":{"line":51,"column":7},"cells":[{"location":{"line":51,"column":9},"value":"/member/marital_status must be equal to one of the allowed values"}]},{"id":"062d54bf-7d98-46d7-8398-9f7ac150db67","location":{"line":52,"column":7},"cells":[{"location":{"line":52,"column":9},"value":"/member/employment_status must be equal to one of the allowed values"}]},{"id":"4f74f1d7-3f1f-425a-8b52-238ab90dd0bc","location":{"line":53,"column":7},"cells":[{"location":{"line":53,"column":9},"value":"/member/occupation must be equal to one of the