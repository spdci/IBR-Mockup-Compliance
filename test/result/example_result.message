have required property 'tag'"}]},{"id":"8677ee6f-381b-4abb-bf77-afd04f65329a","location":{"line":29,"column":7},"cells":[{"location":{"line":29,"column":9},"value":"on-search"},{"location":{"line":29,"column":30},"value":"iv"},{"location":{"line":29,"column":46},"value":"must have required property 'iv'"}]},{"id":"3e704f3a-2039-4f3a-930b-198abae00b81","location":{"line":30,"column":7},"cells":[{"location":{"line":30,"column":9},"value":"on-search"},{"location":{"line":30,"column":30},"value":"header"},{"location":{"line":30,"column":46},"value":"/message must have required property 'header'"}]},{"id":"bc8afd45-501d-4084-be66-89b717ad5c11","location":{"line":31,"column":7},"cells":[{"location":{"line":31,"column":9},"value":"on-search"},{"location":{"line":31,"column":30},"value":"header.kid"},{"location":{"line":31,"column":46},"value":"/message/header must have required property 'kid'"}]},{"id":"fdcdf017-b799-4d3b-91b1-534bdb6e52c0","location":{"line":32,"column":7},"cells":[{"location":{"line":32,"column":9},"value":"enrollment-updates"},{"location":{"line":32,"column":30},"value":"ciphertext"},{"location":{"line":32,"column":46},"value":"must have required property 'ciphertext'"}]},{"id":"9c22a07c-ece9-4dfd-9d46-c6bb373b2179","location":{"line":33,"column":7},"cells":[{"location":{"line":33,"column":9},"value":"enrollment-updates"},{"location":{"line":33,"column":30},"value":"header.alg"},{"location":{"line":33,"column":46},"value":"/message/header must have required property 'alg'"}]}]}]}}]},"comments":[],"uri":"features/ibr_encrypted_messages.feature"}}
