ing the Beneficiary records \"<profile>\""},{"id":"1d8af6cc-acee-4ea3-a6db-b475ed9bc8cb","location":{"line":38,"column":5},"keyword":"Then ","keywordType":"Outcome","text":"the request should be a valid \"enrollment-updates\" message"},{"id":"3f38a885-12ae-4f96-9f24-129c6f53f8ef","location":{"line":39,"column":5},"keyword":"When ","keywordType":"Action","text":"the request is sent"},{"id":"b290c81f-b10c-43c3-ac1f-a337a845327f","location":{"line":40,"column":5},"keyword":"Then ","keywordType":"Outcome","text":"the response should be a valid \"enrollment-updates-response\" message"},{"id":"5fbd2c35-60a4-4d4d-85a5-16e7eb908f79","location":{"line":41,"column":5},"keyword":"And ","keywordType":"Conjunction","text":"every published beneficiary should be acknowledged"}],"examples":[{"id":"d4dd59f8-4830-4e39-9883-52b6cdecab86","tags":[],"location":{"line":43,"column":5},"keyword":"Examples","name":"","description":"","tableHeader":{"id":"d2940057-b17e-4941-81d3-d9d9da689157","location":{"line":44,"column":7},"cells":[{"location":{"line":44,"column":9},"value":"profile"},{"location":{"line":44,"column":22},"value":"case"}]},"tableBody":[{"id":"f8c43f72-b45f-4992-81b7-978e7032903c","location":{"line":45,"column":7},"cells":[{"location":{"line":45,"column":9},"value":"household"},{"location":{"line":45,"column":22},"value":"household, cash benefits, every Beneficiary attribute"}]},{"id":"afab371e-5681-4560-9eac-4b5e44e14ccf","location":{"line":46,"column":7},"cells":[{"location":{"line":46,"column":9},"value":"individual"},{"location":{"line":46,"column":22},"value":"individual, cash benefit, enrollment_* spelling"}]},{"id":"82118a79-b783-43bf-a54c-c4c9fb3be08e","location":{"line":47,"column":7},"cells":[{"location":{"line":47,"column":9},"value":"in-kind"},{"location":{"line":47,"column":22},"value":"in-kind, voucher and insurance benefits for a child"}]},{"id":"323dc014-4f70-4aa3-9a3c-45cab0288122","location":{"line":48,"column":7},"cells":[{"location":{"line":48,"column":9}