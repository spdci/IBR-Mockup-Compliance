atus_response.txn_type"},{"location":{"line":65,"column":111},"value":"\"notify\""}]},{"id":"f3aedda0-e388-4ff4-a3a1-c416258d53f9","location":{"line":66,"column":7},"cells":[{"location":{"line":66,"column":9},"value":"txn_status not matching txn_type"},{"location":{"line":66,"column":46},"value":"message.txnstatus_response.txn_type"},{"location":{"line":66,"column":111},"value":"\"receipt\""}]},{"id":"4fb6e287-9a1c-4132-bb5c-a527d61adfaf","location":{"line":67,"column":7},"cells":[{"location":{"line":67,"column":9},"value":"missing txn_status"},{"location":{"line":67,"column":46},"value":"message.txnstatus_response.txn_status"},{"location":{"line":67,"column":111},"value":"<removed>"}]},{"id":"369dafea-efb3-4169-8790-057bf02a4a6b","location":{"line":68,"column":7},"cells":[{"location":{"line":68,"column":9},"value":"search result with invalid status"},{"location":{"line":68,"column":46},"value":"message.txnstatus_response.txn_status.search_response.0.status"},{"location":{"line":68,"column":111},"value":"\"found\""}]},{"id":"30da4a82-b4d3-4d5d-8dd7-9bfb758e0814","location":{"line":69,"column":7},"cells":[{"location":{"line":69,"column":9},"value":"search result without data records"},{"location":{"line":69,"column":46},"value":"message.txnstatus_response.txn_status.search_response.0.data"},{"location":{"line":69,"column":111},"value":"{\"reg_record_type\":\"Beneficiary\"}"}]}]},{"id":"c80c7c03-e274-4f4c-a702-80ff830ea145","tags":[{"location":{"line":71,"column":5},"name":"@strict-data","id":"ba812d88-711f-4c0a-bdeb-38e6f62cfde7"}],"location":{"line":72,"column":5},"keyword":"Examples","name":"IBR data in the transaction status","description":"","tableHeader":{"id":"d53ec049-1b64-4760-8383-d1321430b255","location":{"line":73,"column":7},"cells":[{"location":{"line":73,"column":9},"value":"case"},{"location":{"line":73,"column":42},"value":"field"},{"location":{"line":73,"column":139},"value":"value"}]},"tableBody":[{"id":"71d01f19-c455-4d98-90c4-ca33b2f65909","locati