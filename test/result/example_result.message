{"pickle":{"id":"a7e7ae29-5d8f-4e40-bdb1-c2f177d7c889","uri":"features/ibr_notify.feature","astNodeIds":["a9910990-327a-4755-b2af-9b642a24a5d1","c19a8fe8-38bf-4502-ae81-a459536a6374"],"name":"An invalid notification is rejected: person birth_date format","language":"en","steps":[{"id":"7d894ce6-74eb-4a46-978d-c2235bdd3f83","text":"the \"notify\" endpoint","type":"Context","astNodeIds":["673b5865-291f-411a-b172-5ece8a0f3a4d"]},{"id":"a2d1a341-6970-4dba-97b5-bae79578ec07","text":"a valid request","type":"Context","astNodeIds":["afabdf1d-3320-45b5-b9fe-b9a98ee61958","c19a8fe8-38bf-4502-ae81-a459536a6374"]},{"id":"7d5c1e0f-08e6-494e-861e-8dc66c6bf9ee","text":"the request field \"message.notify_event.0.data.reg_records.0.member.demographic_info.birth_date\" becomes '\"05-05-1950\"'","type":"Context","astNodeIds":["049b2c6e-3e05-49d0-855f-fa0d39ec97db","c19a8fe8-38bf-4502-ae81-a459536a6374"]},{"id":"acf3657e-c089-40bc-ae7c-175e5be8f874","text":"the request is sent","type":"Action","astNodeIds":["6731c633-f1b5-43fa-9168-038b3ec57234","c19a8fe8-38bf-4502-ae81-a459536a6374"]},{"id":"895e0876-d6ee-4bb9-87d5-40f2b22ed902","text":"the request should be rejected according to the DCI error model","type":"Outcome","astNodeIds":["6ce1e367-34c9-4d88-9604-8a9ed4a5acab","c19a8fe8-38bf-4502-ae81-a459536a6374"]}],"tags":[{"name":"@method=POST","astNodeId":"8df28692-adec-4b93-9175-9ff67bdcf127"},{"name":"@endpoint=ibr/notify","astNodeId":"7a9d15fd-84e1-4884-89bf-3080484e95f2"},{"name":"@negative","astNodeId":"9c1c7ea1-7abb-4c30-90fb-a8279d4fecc4"},{"name":"@strict-data","astNodeId":"6dac9016-6dbe-4225-92c2-ef0047ea43ab"}]}}
{"pickle":{"id":"165e206a-480a-488c-b6e8-11d604b74dfd","uri":"features/ibr_notify.feature","astNodeIds":["a9910990-327a-4755-b2af-9b642a24a5d1","f5acb245-6502-4219-8b53-24f6f55cef4b"],"name":"An invalid notification is rejected: member records with bad sex","language":"en","steps":[{"id":"069eef2b-1ccc-4528-9c25-4bc7801423d9","text":"the \"notify\" endpoint","type":"Context","astNodeIds":["673b5865-291f-411a-b172-5ece8a0f3a4d"]},{"id":"7788f743-751f-48bc-ab04-e207a0ab3b9c","text":"a valid request","type":"Context","astNodeIds":["afabdf1d-3320-45b5-b9fe-b9a98ee61958","f5acb245-6502-4219-8b53-24f6f55cef4b"]},{"id":"edd8dfb2-1019-413c-83d3-c8ef6a425b8e","text":"the request field \"message.notify_event.0.data\" becomes '{\"reg_event_type\":\"enrollement\",\"reg_record_type\":\"Member\",\"reg_records\":[{\"demographic_info\":{\"sex\":\"Male\"}}]}'","type":"Context","astNodeIds":["049b2c6e-3e05-49d0-855f-fa0d39ec97db","f5acb245-6502-4219-8b53-24f6f55cef4b"]},{"id":"5fd70f58-a375-4355-9321-2151c079298c","text":"the request is sent","type":"Action","astNodeIds":["6731c633-f1b5-43fa-9168-038b3ec57234","f5acb245-6502-4219-8b53-24f6f55cef4b"]},{"id":"07ea922e-92b9-45d2-8319-79fc0b336ff1","text":"the request should be rejected according to the DCI error model","type":"Outcome","astNodeIds":["6ce1e367-34c9-4d88-9604-8a9ed4a5acab","f5acb245-6502-4219-8b53-24f6f55cef4b"]}],"tags":[{"name":"@method=POST","astNodeId":"8df28692-adec-4b93-9175-9ff67bdcf127"},{"name":"@endpoint=ibr/notify","astNodeId":"7a9d15fd-84e1-4884-89bf-3080484e95f2"},{"name":"@negative","astNodeId":"9c1c7ea1-7abb-4c30-90fb-a8279d4fecc4"},{"name":"@strict-data","astNodeId":"6dac9016-6dbe-4225-92c2-ef0047ea43ab"}]}}
{"source":{"data":"@method=POST @endpoint=ibr/on-search\nFeature: Receive async search results from the IBR (POST /registry/on-search)\n\nThis API is exposed by the SP-MIS to receive search results from the IBR.\nThe suite plays the IBR: every payload it sends is first checked against the spec\n(including the IBR data rules for beneficiaries, persons, members and groups), then the\nSP-MIS must acknowledge it.\n\n  Background:\n    Given the \"on-search\" endpoint\n\n  @smoke\n  Scenario: Successfully receive async search results from the IBR\n    Given an on-search callback carrying the \"household\" Beneficiary record\n    Then the request should be a valid \"on-search\" message\n    When the request is sent\n    Then the HTTP status should be 200\n    And the response should have a JSON content type\n    And the response should be received within 15000 ms\n    And the response should be a valid acknowledgement with ack_status \"ACK\"\n\n  @functional\n  Scenario Outline: Results carrying the <profile> <type> record are acknowledged\n    Given an on-search callback carrying the \"<profile>\" <type> record\n    Then the request should be a valid \"on-search\" message\n    When the request is sent\n    Then the response should be a valid acknowledgement with ack_status \"ACK\"\n\n    Examples: Beneficiaries\n      | type        | profile    |\n      | Beneficiary | household  |\n      | Beneficiary | individual |\n      | Beneficiary | graduated  |\n      | Beneficiary | suspended  |\n      | Beneficiary | deceased   |\n      | Beneficiary | in-kind    |\n      | Beneficiary | minimal    |\n\n    Examples: Persons\n      | type      | profile        |\n      | IBRPerson | example person |\n      | IBRPerson | full           |\n      | IBRPerson | minimal        |\n      | IBRPerson | deceased       |\n      | IBRPerson | multi          |\n      | IBRPerson | newborn        |\n\n    Examples: Members\n      | type   | profile  |\n      | Member | full     |\n      | Member | minimal  |\n      | Member | spouse   |\n      | Member | child    |\n      | Member | disabled |\n      | Member | widow    |\n      | Member | deceased |\n\n    Examples: Groups\n      | type  | profile |\n      | Group | full    |\n      | Group | minimal |\n      | Group | large   |\n      | Group | single  |\n\n  @functional\n  Scenario Outline: Results carrying several <type> records are acknowledged\n    Given an on-search callback carrying the <type> records \"<records>\"\n    Then the request should be a valid \"on-search\" message\n    When the request is sent\n    Then the response should be a valid acknowledgement with ack_status \"ACK\"\n\n    Examples:\n      | type        | records                                      |\n      | Beneficiary | household, individual, graduated, deceased   |\n      | IBRPerson   | full, deceased, newborn                      |\n      | Member      | widow, grandson                              |\n      | Group       | full, large, single, minimal                 |\n\n  @functional\n  Scenario: Untyped reg_records are Beneficiary records, as declared by the spec\n    Given an on-search callback carrying the \"household\" Beneficiary record without a reg_record_type\n    Then the request should be a valid \"on-search\" message\n    When the request is sent\n    Then the response should be a valid acknowledgement with ack_status \"ACK\"\n\n  @functional\n  Scenario Outline: An empty <type> result is acknowledged\n    Given an on-search callback with an empty <type> result\n    Then the request should be a valid \"on-search\" message\n    When the request is sent\n    Then the response should be a valid acknowledgement with ack_status \"ACK\"\n\n    Examples:\n      | type        |\n      | Beneficiary |\n      | IBRPerson   |\n      | Member      |\n      | Group       |\n\n  @functional\n  Scenario Outline: A rejected search with reason code <code> is acknowledged\n    Given an on-search callback rejected with reason code \"<code>\"\n    Then the request should be a valid \"on-search\" message\n    When the request is sent\n    Then the response should be a valid acknowledgement with ack_status \"ACK\"\n\n    Examples: SearchStatusReasonCode\n      | code                               |\n      | rjct.reference_id.invalid          |\n      | rjct.reference_id.duplicate        |\n      | rjct.timestamp.invalid             |\n      | rjct.search_criteria.invalid       |\n      | rjct.filter.invalid                |\n      | rjct.sort.invalid                  |\n      | rjct.pagination.invalid            |\n      | rjct.search.too_many_records_found |\n\n  @negative\n  Scenario Outline: An invalid on-search callback is rejected: <case>\n    Given a valid request\n    And the request field \"<field>\" becomes '<value>'\n    When the request is sent\n    Then the request should be rejected according to the DCI error model\n\n    Examples: Envelope and header\n      | case                       | field                     | value          |\n      | missing header             | header                    | <removed>      |\n      | wrong action               | header.action             | \"search\"       |\n      | missing header status      | header.status             | <removed>      |\n      | unknown header status      | header.status             | \"done\"         |\n      | unknown header reason code | header.status_reason_code | \"rjct.unknown\" |\n      | missing message_ts         | header.message_ts         | <removed>      |\n\n    Examples: Search response\n      | case                         | field                                           | value               |\n      | missing transaction_id       | message.transaction_id                          | <removed>           |\n      | missing correlation_id       | message.correlation_id                          | <removed>           |\n      | correlation_id invalid chars | message.correlation_id                          | \"IBR 0001\"          |\n      | missing search_response      | message.search_response                         | <removed>           |\n      | missing status               | message.search_response.0.status                | <removed>           |\n      | unknown status               | message.search_response.0.status                | \"ok\"                |\n      | unknown reason code          | message.search_response.0.status_reason_code    | \"rjct.not_found\"    |\n      | data without reg_records     | message.search_response.0.data                  | {\"version\":\"1.0.0\"} |\n      | unknown reg_record_type      | message.search_response.0.data.reg_record_type  | \"Programme\"         |\n      | pagination missing total     | message.search_response.0.pagination            | {\"page_size\":1,\"page_number\":1} |\n      | locale not ISO 639-3         | message.search_response.0.locale                | \"en\"                |\n\n    @strict-data\n    Examples: Beneficiary data in the result\n      | case                              | field                                                                          | value              |\n      | reg_records not an array          | message.search_response.0.data.reg_records                                     | {\"assistance_unit\":\"2\"} |\n      | assistance unit as a label        | message.search_response.0.data.reg_records.0.assistance_unit                   | \"household\"        |\n      | enrolment status as a label       | message.search_response.0.data.reg_records.0.enrolment_status                  | \"Active\"           |\n      | enrolment date not ISO 8601       | message.search_response.0.data.reg_records.0.enrolment_date                    | \"02.02.2022\"       |\n      | status change date not a list     | message.search_response.0.data.reg_records.0.status_change_date                | \"2022-02-01\"       |\n      | programmes as a single object     | message.search_response.0.data.reg_records.0.programme_identifier              | {\"programme_name\":\"Child Support Grant\",\"programme_identifier\":\"DCI001\"} |\n      | programme without a name          | message.search_response.0.data.reg_records.0.programme_identifier.0.programme_name | <removed>      |\n      | institution type as a label       | message.search_response.0.data.reg_records.0.programme_identifier.0.institution_type | \"Public\"     |\n      | social protection function label  | message.search_response.0.data.reg_records.0.programme_identifier.0.social_protection_functions | [\"Family\"] |\n      | frequency as text                 | message.search_response.0.data.reg_records.0.programme_identifier.0.benefit_frequency | \"Monthly\"   |\n      | benefit type as a label           | message.search_response.0.data.reg_records.0.benefits.0.benefit_type           | \"Cash\"             |\n      | benefit value with a currency     | message.search_response.0.data.reg_records.0.benefits.0.benefit_value          | \"USD 50\"           |\n      | benefit quantity as text          | message.search_response.0.data.reg_records.0.benefits.0.benefit_quantity       | \"5\"                |\n      | member identifier as a string     | message.search_response.0.data.reg_records.0.member.member_identifier          | \"M100000001\"       |\n      | member marital status as label    | message.search_response.0.data.reg_records.0.member.marital_status             | \"married\"          |\n      | member person sex outside list    | message.search_response.0.data.reg_records.0.member.demographic_info.sex       | \"F\"                |\n      | member phone not E.164            | message.search_response.0.data.reg_records.0.member.demographic_info.phone_number | [\"0891234567\"]  |\n      | group type as a label             | message.search_response.0.data.reg_records.0.group.group_type                  | \"household\"        |\n      | group head education as label     | message.search_response.0.data.reg_records.0.group.group_head_info.education_level | \"bachelor\"     |\n      | group member relationship label   | message.search_response.0.data.reg_records.0.group.member_list.0.related_person.0.relationship_type | \"spouse\" |\n\n    @strict-data\n    Examples: Person, member and group data in the result\n      | case                           | field                          | value                 |\n      | person records with bad sex    | message.search_response.0.data | {\"reg_record_type\":\"IBRPerson\",\"reg_records\":[{\"identifier\":[{\"identifier_type\":\"UIN\",\"identifier_value\":\"1\"}],\"sex\":\"F\"}]} |\n      | person birth_date not ISO 8601 | message.search_response.0.data | {\"reg_record_type\":\"IBRPerson\",\"reg_records\":[{\"birth_date\":\"20/05/1985\"}]} |\n      | person e-mail invalid          | message.search_response.0.data | {\"reg_record_type\":\"IBRPerson\",\"reg_records\":[{\"email\":[\"alice.example.org\"]}]} |\n      | member employment as label     | message.search_response.0.data | {\"reg_record_type\":\"Member\",\"reg_records\":[{\"employment_status\":\"employed\"}]} |\n      | member language not ISO 639    | message.search_response.0.data | {\"reg_record_type\":\"Member\",\"reg_records\":[{\"language_code\":[\"English\"]}]} |\n      | group size as text             | message.search_response.0.data | {\"reg_record_type\":\"Group\",\"reg_records\":[{\"group_size\":\"4\"}]} |\n      | group poverty score as text    | message.search_response.0.data | {\"reg_record_type\":\"Group\",\"reg_records\":[{\"poverty_score\":\"3.75\"}]} |\n","uri":"features/ibr_on-search.feature","mediaType":"text/x.cucumber.gherkin+plain"}}
{"gherkinDocument":{"feature":{"tags":[{"location":{"line":1,"column":1},"name":"@method=POST","id":"81cc5a1f-af10-4cfb-b841-636f6769327f"},{"location":{"line":1,"column":14},"name":"@endpoint=ibr/on-search","id":"ca7700f5-fb90-4a3b-8cfd-deeaf968b49d"}],"location":{"line":2,"column":1},"language":"en","keyword":"Feature","name":"Receive async search results from the IBR (POST /registry/on-search)","description":"This API is exposed by the SP-MIS to receive search results from the IBR.\nThe suite plays the IBR: every payload it sends is first checked against the spec\n(including the IBR data rules for beneficiaries, persons, members and groups), then the\nSP-MIS must acknowledge it.","children":[{"background":{"id":"c0fed16e-fc6d-4192-8ae3-62bcc096bf78","location":{"line":9,"column":3},"keyword":"Background","name":"","description":"","steps":[{"id":"3f24b3fb-7fe1-4cbb-a3f5-88c21e4dae36","location":{"line":10,"column":5},"keyword":"Given ","keywordType":"Context","text":"the \"on-search\" endpoint"}]}},{"scenario":{"id":"a476a05f-be38-4252-8f28-a6b8c0d307f3","tags":[{"location":{"line":12,"column":3},"name":"@smoke","id":"f26a5b4c-3538-4bd4-85a7-f5e534ac5306"}],"location":{"line":13,"column":3},"keyword":"Scenario","name":"Successfully receive async search results from the IBR","description":"","steps":[{"id":"924fe68e-294b-4d76-a7ce-ccbaabb6d683","location":{"line":14,"column":5},"keyword":"Given ","keywordType":"Context","text":"an on-search callback carrying the \"household\" Beneficiary record"},{"id":"6768a348-5d1d-4dbc-95b8-5a69f763f3c2","location":{"line":15,"column":5},"keyword":"Then ","keywordType":"Outcome","text":"the request should be a valid \"on-search\" message"},{"id":"72f1a156-4ecd-4776-b0a7-c5f4dad1ae1d","location":{"line":16,"column":5},"keyword":"When ","keywordType":"Action","text":"the request is sent"},{"id":"499ab4c6-e492-4f91-9d4d-741926e5d158","location":{"line":17,"column":5},"keyword":"Then ","keywordType":"Outcome","text":"the HTTP status should be 200"},{"id":"06726ac2-206f-4ffd-b3f8-404143a55127","location":{"line":18,"column":5},"keyword":"And ","keywordType":"Conjunction","text":"the response should have a JSON content type"},{"id":"5637b015-1fbc-469b-a992-1612e1136038","location":{"line":19,"column":5},"keyword":"And ","keywordType":"Conjunction","text":"the response should be received within 15000 ms"},{"id":"b52e7abf-70ea-44fe-b5b5-b72417696668","location":{"line":20,"column":5},"keyword":"And ","keywordType":"Conjunction","text":"the response should be a valid acknowledgement with ack_status \"ACK\""}],"examples":[]}},{"scenario":{"id":"a50219ad-f2d5-499c-b959-4804c01a9ab0","tags":[{"location":{"line":22,"column":3},"name":"@functional","id":"e3fa9d69-de07-4c24-b55a-264f0da1f7c5"}],"location":{"line":23,"column":3},"keyword":"Scenario Outline","name":"Results carrying the <profile> <type> record are acknowledged","description":"","steps":[{"id":"016cd4d0-9de8-4fd1-a66b-be8d509d0a33","location":{"line":24,"column":5},"keyword":"Given ","keywordType":"Context","text":"an on-search callback carrying the \"<profile>\" <type> record"},{"id":"9cf0ccb5-3349-4a02-b308-c0b56ce8f7cd","location":{"line":25,"column":5},"keyword":"Then ","keywordType":"Outcome","text":"the request should be a valid \"on-search\" message"},{"id":"29d36c00-b90c-492c-98ef-0a0b0c1562bc","location":{"line":26,"column":5},"keyword":"When ","keywordType":"Action","text":"the request is sent"},{"id":"0c6d0d2c-cd86-45b3-a3e9-6045182dbcc6","location":{"line":27,"column":5},"keyword":"Then ","keywordType":"Outcome","text":"the response should be a valid acknowledgement with ack_status \"ACK\""}],"examples":[{"id":"266e9d12-5ea7-4fec-85b6-611ac17deab2","tags":[],"location":{"line":29,"column":5},"keyword":"Examples","name":"Beneficiaries","description":"","tableHeader":{"id":"049e0480-bd41-4fc3-9c50-ffaa46836473","location":{"line":30,"column":7},"cells":[{"location":{"line":30,"column":9},"value":"type"},{"location":{"line":30,"co